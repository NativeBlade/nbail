{
    "name": "nativeblade/nbail",
    "description": "Docker development environment for NativeBlade apps, in the spirit of Laravel Sail.",
    "type": "library",
    "license": "MIT",
    "keywords": ["nativeblade", "docker", "laravel", "tauri", "development"],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "NativeBlade\\Nbail\\": "src/"
        }
    },
    "bin": [
        "bin/nbail"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NativeBlade\\Nbail\\NbailServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
